# JVM options read by the Gradle application start script.
JAVA_OPTS="-Xms2g -Xmx2g -XX:MaxDirectMemorySize=2g -XX:+UseZGC -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError -Dio.netty.leakDetection.level=disabled"

# Used by /opt/strataproxy/config/strataproxy-production.yml.
STRATAPROXY_ADMIN_TOKEN="change-me"
STRATAPROXY_DATA_DIR="/var/lib/strataproxy"
