[Unit]
Description=StrataProxy Minecraft Proxy
Documentation=file:/opt/strataproxy/deployment/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=strataproxy
Group=strataproxy
WorkingDirectory=/opt/strataproxy
EnvironmentFile=/etc/strataproxy/strataproxy.env
ExecStart=/opt/strataproxy/bin/strataproxy /opt/strataproxy/config/strataproxy-production.yml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/strataproxy /var/log/strataproxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SuccessExitStatus=130 143

[Install]
WantedBy=multi-user.target
