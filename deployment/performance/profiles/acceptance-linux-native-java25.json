{
  "id": "acceptance-linux-native-java25",
  "description": "Production-scale acceptance profile for Linux native transport and Java 25.",
  "java": "25",
  "transport": "linux-native-epoll",
  "requiresNativeTransport": true,
  "hostPrerequisites": {
    "ulimitNofile": 1048576,
    "recommendedCores": 8,
    "recommendedMemoryGiB": 8
  },
  "jvmOptions": [
    "-Xms2g",
    "-Xmx2g",
    "-XX:MaxDirectMemorySize=2g",
    "-XX:+UseZGC",
    "-XX:+AlwaysPreTouch",
    "-XX:+ExitOnOutOfMemoryError"
  ],
  "commands": [
    {
      "name": "load-suite-acceptance",
      "tool": "strataproxy-query",
      "args": [
        "--host", "127.0.0.1",
        "--port", "25577",
        "load-suite",
        "--profile", "acceptance",
        "--virtual-host", "play.example.net",
        "--parallelism", "512",
        "--json"
      ]
    },
    {
      "name": "slo-gate",
      "tool": "strataproxy-admin",
      "args": [
        "--base-url", "http://127.0.0.1:8080",
        "slo",
        "--require-ready",
        "--max-event-loop-delay-ms", "5",
        "--max-rejected", "0",
        "--max-anomalies", "0"
      ]
    }
  ],
  "gates": {
    "minIdleConnections": 10000,
    "minActiveConnections": 2000,
    "minTrafficPackets": 400000,
    "maxFailed": 0,
    "maxP99ProxyForwardingLatencyMillis": 5,
    "maxEventLoopDelayMillis": 5,
    "maxRejectedConnections": 0,
    "maxPacketAnomalies": 0
  }
}
