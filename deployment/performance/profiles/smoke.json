{
  "id": "smoke",
  "description": "Small local sanity profile for CI and developer machines.",
  "java": "25",
  "transport": "any",
  "requiresNativeTransport": false,
  "jvmOptions": [
    "-Xms1g",
    "-Xmx1g",
    "-XX:MaxDirectMemorySize=1g",
    "-XX:+UseZGC"
  ],
  "commands": [
    {
      "name": "load-suite-smoke",
      "tool": "strataproxy-query",
      "args": [
        "--host", "127.0.0.1",
        "--port", "25577",
        "load-suite",
        "--profile", "smoke",
        "--idle-connections", "100",
        "--active-connections", "10",
        "--traffic-packets-per-connection", "10",
        "--parallelism", "64",
        "--json"
      ]
    }
  ],
  "gates": {
    "minIdleConnections": 100,
    "minActiveConnections": 10,
    "minTrafficPackets": 100,
    "maxFailed": 0,
    "maxEventLoopDelayMillis": 25,
    "maxRejectedConnections": 0,
    "maxPacketAnomalies": 0
  }
}
