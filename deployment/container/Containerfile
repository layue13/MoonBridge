ARG JAVA_IMAGE=eclipse-temurin:25-jdk
ARG RUNTIME_IMAGE=eclipse-temurin:25-jre

FROM ${JAVA_IMAGE} AS build
WORKDIR /workspace
COPY . .
RUN ./gradlew --no-daemon :proxy-app:installDist

FROM ${RUNTIME_IMAGE}
RUN useradd --system --home-dir /opt/strataproxy --shell /usr/sbin/nologin strataproxy
WORKDIR /opt/strataproxy
COPY --from=build /workspace/proxy-app/build/install/strataproxy/ /opt/strataproxy/
RUN mkdir -p /opt/strataproxy/data \
    && cp /opt/strataproxy/config/strataproxy-production.yml /opt/strataproxy/config/strataproxy.yml \
    && chown -R strataproxy:strataproxy /opt/strataproxy
USER strataproxy
EXPOSE 25577
VOLUME ["/opt/strataproxy/data"]
ENV JAVA_OPTS="-Xms2g -Xmx2g -XX:MaxDirectMemorySize=2g -XX:+UseZGC -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError -Dio.netty.leakDetection.level=disabled"
ENTRYPOINT ["/opt/strataproxy/bin/strataproxy"]
CMD ["/opt/strataproxy/config/strataproxy.yml"]
